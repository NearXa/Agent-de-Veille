# Copier ce fichier en .env et renseigner les valeurs. Aucun secret n'est versionné.

# --- LLM (Vercel AI SDK) ---
LLM_PROVIDER=anthropic            # anthropic | openai | mistral
LLM_MODEL=claude-opus-5-5         # ex. claude-sonnet-5-5 (moins cher), gpt-5.4-mini, mistral-medium-latest
LLM_EFFORT=medium                 # Anthropic uniquement : low | medium | high | xhigh | max
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
LLM_CACHE=1                       # 1 = relire les réponses mises en cache dans data/cache/llm (démo sans aléa)
LLM_MAX_COST_PER_RUN=2            # garde-fou : coût maximal estimé par run, en dollars US
LLM_TIMEOUT_MS=180000             # délai maximal par appel LLM

# --- Notion ---
NOTION_TOKEN=                     # token d'intégration interne (capacités : lire, mettre à jour, insérer du contenu, insérer des commentaires)
NOTION_PARENT_PAGE_ID=            # ID de la page parente (partagée avec l'intégration) sous laquelle créer les 6 bases
NOTION_API_VERSION=2025-09-03
# Les IDs des bases sont écrits par `pnpm notion init` dans notion/ids.json (ignoré par git).

# --- PISTE (Légifrance, Judilibre) : optionnel, phase 2 ---
PISTE_CLIENT_ID=                  # identifiants OAuth2 de l'application PISTE (Légifrance)
PISTE_CLIENT_SECRET=
PISTE_API_KEY=                    # clé API PISTE (en-tête KeyId) pour Judilibre
PISTE_ENV=sandbox                 # sandbox | production

# --- Divers ---
LOG_LEVEL=info                    # trace | debug | info | warn | error
LOG_FORMAT=pretty                 # pretty | json
VEILLE_ROOT=                      # racine du dépôt si les commandes ne sont pas lancées depuis la racine
