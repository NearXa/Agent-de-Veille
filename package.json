{
  "name": "veille-grc",
  "version": "0.1.0",
  "private": true,
  "description": "Agent de veille continue GRC et législative : ingestion de textes officiels, extraction d'exigences vérifiables, matrices GRC, Notion et cockpit Streamlit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx agent/src/cli.ts",
    "notion": "tsx agent/src/cli.ts notion",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "cockpit": ".venv/bin/streamlit run cockpit/app.py",
    "cockpit:test": ".venv/bin/python -m pytest cockpit/tests -q",
    "chat": "pnpm --filter veille-grc-chat dev",
    "chat:build": "pnpm --filter veille-grc-chat build",
    "chat:start": "pnpm --filter veille-grc-chat start",
    "chat:typecheck": "pnpm --filter veille-grc-chat typecheck"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/mcp": "^2.0.85",
    "@ai-sdk/mistral": "^4.0.72",
    "@ai-sdk/openai": "^4.0.102",
    "@notionhq/client": "^5.28.0",
    "ai": "^7.0.153",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "node-cron": "^4.6.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "domhandler": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
